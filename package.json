{
  "name": "ourfilm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "types:gen": "supabase gen types typescript --linked > lib/supabase/database.types.ts",
    "types:check": "node scripts/check-supabase-types.mjs linked",
    "types:check:local": "node scripts/check-supabase-types.mjs local",
    "seed": "node --env-file=.env.local --experimental-strip-types scripts/seed.ts",
    "grant": "node --env-file=.env.local --experimental-strip-types scripts/grant-event.ts",
    "reset:data": "node --env-file=.env.local --experimental-strip-types scripts/reset-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "heic-to": "^1.5.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "p-retry": "^8.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "standardwebhooks": "1.0.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.17.0",
    "sharp": "^0.35.3",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
