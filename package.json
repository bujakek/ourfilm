{
  "name": "ourfilm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test": "pnpm --filter web test",
    "test:watch": "pnpm --filter web test:watch",
    "verify": "pnpm --filter web verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:gen": "supabase gen types typescript --linked > apps/web/lib/supabase/database.types.ts",
    "types:check": "node scripts/check-supabase-types.mjs linked",
    "types:check:local": "node scripts/check-supabase-types.mjs local",
    "test:db": "node scripts/test-db.mjs",
    "seed": "pnpm --filter web seed",
    "grant": "pnpm --filter web grant",
    "takedown": "pnpm --filter web takedown",
    "reset:data": "pnpm --filter web reset:data",
    "verify:worker": "pnpm --filter @ourfilm/shared typecheck && pnpm --filter worker typecheck && pnpm --filter worker test"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4.3.3"
  }
}
